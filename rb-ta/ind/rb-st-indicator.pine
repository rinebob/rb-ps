//@version=6
indicator("Savant Trader ST", "ST", overlay=false, timeframe="", timeframe_gaps=false)

// Standalone, read-only ST indicator foundation.
//
// This file is the single TradingView entry point for the ST port. The
// indicator calculations are added in dependency order in later tasks:
// shared math/state, Trend Bands and zones, Trend Strength, then the Zone
// V1/V2 price-pane event overlay.
//
// Keep the historical rb-ps Pine files unchanged. This file is intentionally
// self-contained so it can be copied into TradingView without a rel-str,
// Firebase, broker, or exported-data dependency.
//
// The fixed HTF multiplier and developing-HTF policy are deliberate v1
// decisions. Developing higher-timeframe values may repaint while the active
// higher-timeframe candle is still forming; the indicator does not wait for
// confirmation before painting interim bars.

// =============================================================================
// FIXED ST CONFIGURATION
// =============================================================================

// Trend Bands: each configured length is used for both pre- and post-smoothing.
const int CTF_FAST_LENGTH = 5
const int CTF_SLOW_LENGTH = 10
const int HTF_MULTIPLIER = 3
const int HTF_FAST_EFFECTIVE_LENGTH = CTF_FAST_LENGTH * HTF_MULTIPLIER
const int HTF_SLOW_EFFECTIVE_LENGTH = CTF_SLOW_LENGTH * HTF_MULTIPLIER

// Trend Strength and event-marker calculations.
const int DI_LENGTH = 14
const float DI_UPPER_THRESHOLD = 10.0
const float DI_LOWER_THRESHOLD = -10.0
const int ATR_LENGTH = 14
const float ZONE_DOT_ATR_MULTIPLIER = 2.5

// =============================================================================
// SHARED MATH
// =============================================================================

// TypeScript emaSeries() uses an SMA seed after `length` valid values, then
// applies the standard EMA recurrence. Missing source values retain the last
// EMA value instead of resetting the series. Chart OHLC is contiguous; any
// non-standard `na` seed behavior is an explicit validation item.
f_ema(series float source, simple int length) =>
    float alpha = 2.0 / (length + 1.0)
    float seed = ta.sma(source, length)
    var float value = na
    value := na(value) ? seed : na(source) ? value : source * alpha + value * (1.0 - alpha)
    value

// Explicit equivalents of the TypeScript crossover/crossunder primitives.
f_crossover(series float left, series float right) =>
    not na(left) and not na(right) and not na(left[1]) and not na(right[1]) and left > right and left[1] <= right[1]

f_crossunder(series float left, series float right) =>
    not na(left) and not na(right) and not na(left[1]) and not na(right[1]) and left < right and left[1] >= right[1]

f_nz(series float value) =>
    na(value) ? 0.0 : value

// Chart-timeframe smoothed Heikin-Ashi band engine. The returned H/L values
// are body-forced from the post-smoothed O/C, matching st-trend-bands.ts.
f_smha_ctf(
    series float sourceOpen,
    series float sourceHigh,
    series float sourceLow,
    series float sourceClose,
    simple int smoothLength,
    simple int afterSmoothLength) =>
    float smoothOpen = f_ema(sourceOpen, smoothLength)
    float smoothHigh = f_ema(sourceHigh, smoothLength)
    float smoothLow = f_ema(sourceLow, smoothLength)
    float smoothClose = f_ema(sourceClose, smoothLength)

    float haClose = (smoothOpen + smoothHigh + smoothLow + smoothClose) / 4.0
    var float haOpen = na
    haOpen := na(haClose) ? na : na(haOpen[1]) ? (smoothOpen + smoothClose) / 2.0 : (haOpen[1] + haClose[1]) / 2.0
    float haHigh = math.max(smoothHigh, math.max(haOpen, haClose))
    float haLow = math.min(smoothLow, math.min(haOpen, haClose))

    float postOpen = f_ema(haOpen, afterSmoothLength)
    float postClose = f_ema(haClose, afterSmoothLength)

    float bandHigh = math.max(postOpen, postClose)
    float bandLow = math.min(postOpen, postClose)
    float bandMid = bandLow + math.abs(bandHigh - bandLow) / 2.0
    bool bandUp = postClose > postOpen
    bool bandDown = postOpen > postClose
    bool crossUp = f_crossover(sourceClose, bandHigh)
    bool crossDown = f_crossunder(sourceClose, bandLow)

    [postOpen, bandHigh, bandLow, postClose, bandMid, bandUp, bandDown, crossUp, crossDown]

// Higher-timeframe smoothed Heikin-Ashi band engine. The recursive HA state
// uses the fixed HTF multiplier and the stepped output updates only at the HTF
// boundary, carrying the latest value across interim chart bars.
f_smha_htf(
    series float sourceOpen,
    series float sourceHigh,
    series float sourceLow,
    series float sourceClose,
    series int htfCloseTime,
    simple int smoothLength,
    simple int afterSmoothLength) =>
    int beforeLength = smoothLength * HTF_MULTIPLIER
    int afterLength = afterSmoothLength * HTF_MULTIPLIER
    bool closeTimeMatch = time_close == htfCloseTime

    float smoothOpen = f_ema(sourceOpen, beforeLength)
    float smoothHigh = f_ema(sourceHigh, beforeLength)
    float smoothLow = f_ema(sourceLow, beforeLength)
    float smoothClose = f_ema(sourceClose, beforeLength)

    float haClose = (smoothOpen + smoothHigh + smoothLow + smoothClose) / 4.0
    var float haOpen = na
    haOpen := na(haClose) ? na : na(haOpen[HTF_MULTIPLIER]) ? (smoothOpen + smoothClose) / 2.0 : (haOpen[HTF_MULTIPLIER] + haClose[HTF_MULTIPLIER]) / 2.0
    float haHigh = math.max(smoothHigh, math.max(haOpen, haClose))
    float haLow = math.min(smoothLow, math.min(haOpen, haClose))

    float postOpen = f_ema(haOpen, afterLength)
    float postClose = f_ema(haClose, afterLength)
    float continuousHigh = math.max(postOpen, postClose)
    float continuousLow = math.min(postOpen, postClose)
    float continuousMid = continuousLow + math.abs(continuousHigh - continuousLow) / 2.0

    var float steppedOpen = na
    var float steppedClose = na
    var float steppedMid = na
    steppedOpen := closeTimeMatch and not na(postOpen) ? postOpen : steppedOpen[1]
    steppedClose := closeTimeMatch and not na(postClose) ? postClose : steppedClose[1]
    steppedMid := closeTimeMatch and not na(continuousMid) ? continuousMid : steppedMid[1]
    float steppedHigh = math.max(steppedOpen, steppedClose)
    float steppedLow = math.min(steppedOpen, steppedClose)
    // TypeScript BandResult direction and cross triggers use the stepped band.
    bool continuousUp = postClose > postOpen
    bool continuousDown = postOpen > postClose
    bool steppedUp = steppedClose > steppedOpen
    bool steppedDown = steppedOpen > steppedClose
    bool crossUp = f_crossover(sourceClose, steppedHigh)
    bool crossDown = f_crossunder(sourceClose, steppedLow)

    // [continuous O/H/L/C/M, continuous up/down, stepped O/H/L/C/M,
    //  stepped up/down, cross up/down, HTF close match]
    [postOpen, continuousHigh, continuousLow, postClose, continuousMid, continuousUp, continuousDown, steppedOpen, steppedHigh, steppedLow, steppedClose, steppedMid, steppedUp, steppedDown, crossUp, crossDown, closeTimeMatch]

// =============================================================================
// DEVELOPING HIGHER-TIMEFRAME DATA
// =============================================================================

// The TypeScript HTF engine runs on chart OHLC with scaled lengths and a
// multiplier-based step. Pine therefore requests only the developing HTF
// boundary and feeds chart OHLC into f_smha_htf; it does not double-scale
// already-aggregated HTF OHLC. No [1] offset is used, so the active HTF
// boundary remains available on realtime bars. Exact wall-clock boundary
// matching can differ from the TypeScript index-based step on irregular
// sessions; later validation must check early closes and missing bars.
string ST_HTF_TIMEFRAME = timeframe.from_seconds(timeframe.in_seconds() * HTF_MULTIPLIER)
int stHtfCloseTime = request.security(
    syminfo.tickerid,
    ST_HTF_TIMEFRAME,
    time_close,
    gaps=barmerge.gaps_off,
    lookahead=barmerge.lookahead_off)

// Instantiate all four band engines. CTF fast/slow use the CTF engine; HTF
// fast/slow use the HTF engine with the fixed multiplier-3 recursive lookback.
// The HTF band output used for plotting and zone classification is the stepped
// series (steppedOpen/High/Low/Close/Mid, steppedUp/steppedDown), matching the
// TypeScript BandResult which is jagged-stepped before direction and crosses.
[stCtfFastOpen, stCtfFastHigh, stCtfFastLow, stCtfFastClose, stCtfFastMid, stCtfFastUp, stCtfFastDown, stCtfFastCrossUp, stCtfFastCrossDown] = f_smha_ctf(open, high, low, close, CTF_FAST_LENGTH, CTF_FAST_LENGTH)
[stCtfSlowOpen, stCtfSlowHigh, stCtfSlowLow, stCtfSlowClose, stCtfSlowMid, stCtfSlowUp, stCtfSlowDown, stCtfSlowCrossUp, stCtfSlowCrossDown] = f_smha_ctf(open, high, low, close, CTF_SLOW_LENGTH, CTF_SLOW_LENGTH)

[stHtfFastOpen, stHtfFastContinuousHigh, stHtfFastContinuousLow, stHtfFastContinuousClose, stHtfFastContinuousMid, stHtfFastContinuousUp, stHtfFastContinuousDown, stHtfFastOpenStepped, stHtfFastHighStepped, stHtfFastLowStepped, stHtfFastCloseStepped, stHtfFastMidStepped, stHtfFastUpStepped, stHtfFastDownStepped, stHtfFastCrossUp, stHtfFastCrossDown, stHtfFastCloseMatch] = f_smha_htf(open, high, low, close, stHtfCloseTime, CTF_FAST_LENGTH, CTF_FAST_LENGTH)
[stHtfSlowOpen, stHtfSlowContinuousHigh, stHtfSlowContinuousLow, stHtfSlowContinuousClose, stHtfSlowContinuousMid, stHtfSlowContinuousUp, stHtfSlowContinuousDown, stHtfSlowOpenStepped, stHtfSlowHighStepped, stHtfSlowLowStepped, stHtfSlowCloseStepped, stHtfSlowMidStepped, stHtfSlowUpStepped, stHtfSlowDownStepped, stHtfSlowCrossUp, stHtfSlowCrossDown, stHtfSlowCloseMatch] = f_smha_htf(open, high, low, close, stHtfCloseTime, CTF_SLOW_LENGTH, CTF_SLOW_LENGTH)

// =============================================================================
// TREND BANDS (CTF + HTF) — main price pane
// =============================================================================

// Four smoothed Heikin-Ashi bands rendered as candles on the main chart.
// Up candles are yellow, down candles are blue, matching the historical
// rb-smha-four-band-plot.pine convention. force_overlay=true places these
// on the price pane even though the indicator default is overlay=false.
color stBandUpColor = color.new(color.yellow, 0)
color stBandDnColor = color.new(color.blue, 0)

plotcandle(stCtfFastOpen, stCtfFastHigh, stCtfFastLow, stCtfFastClose, title="CTF smHA fast", color=stCtfFastClose > stCtfFastOpen ? stBandUpColor : stBandDnColor, force_overlay=true)
plotcandle(stCtfSlowOpen, stCtfSlowHigh, stCtfSlowLow, stCtfSlowClose, title="CTF smHA slow", color=stCtfSlowClose > stCtfSlowOpen ? stBandUpColor : stBandDnColor, force_overlay=true)
plotcandle(stHtfFastOpenStepped, stHtfFastHighStepped, stHtfFastLowStepped, stHtfFastCloseStepped, title="HTF smHA fast", color=stHtfFastCloseStepped > stHtfFastOpenStepped ? stBandUpColor : stBandDnColor, force_overlay=true)
plotcandle(stHtfSlowOpenStepped, stHtfSlowHighStepped, stHtfSlowLowStepped, stHtfSlowCloseStepped, title="HTF smHA slow", color=stHtfSlowCloseStepped > stHtfSlowOpenStepped ? stBandUpColor : stBandDnColor, force_overlay=true)

// =============================================================================
// ZONE V1 / V2 — lower pane
// =============================================================================

// Bar midpoint used by both zone classifiers. TypeScript uses
// (high + low) / 2; the historical Pine used low + abs(high - low) / 2,
// which is equivalent. Use the TypeScript form for clarity.
float stBarMid = (high + low) / 2.0

// --- Zone V1: -3 to +3 from bands 1/2/3 (CTF fast, CTF slow, HTF fast) ---
// Warm-up guard: TypeScript st-zone.ts skips bars where any required band
// midpoint is NaN. Pine bool comparisons with na return false, so V1 is
// safe-by-accident, but the explicit guard documents intent and protects
// against future refactors that might change the comparison chain.
bool stV1Ready = not na(stCtfFastMid) and not na(stCtfSlowMid) and not na(stHtfFastMidStepped)

// Composite trend category from band 1/2/3 direction flags. The HTF band
// uses the stepped direction (steppedUp/steppedDown) to match the TypeScript
// BandResult which computes up/dn from the jagged-stepped O/C values.
bool stV1ThreeUp = (stCtfFastUp and stCtfSlowUp and stHtfFastUpStepped) or (stCtfFastUp and stCtfSlowDown and stHtfFastUpStepped)
bool stV1TwoUp = stCtfFastDown and stCtfSlowUp and stHtfFastUpStepped
bool stV1OneUp = stCtfFastDown and stCtfSlowDown and stHtfFastUpStepped
bool stV1OneDown = stCtfFastUp and stCtfSlowUp and stHtfFastDownStepped
bool stV1TwoDown = stCtfFastUp and stCtfSlowDown and stHtfFastDownStepped
bool stV1ThreeDown = (stHtfFastDownStepped and stCtfSlowDown and stCtfFastDown) or (stHtfFastDownStepped and stCtfSlowUp and stCtfFastDown)

bool stV1IsUpCategory = stV1OneUp or stV1TwoUp or stV1ThreeUp
bool stV1IsDownCategory = stV1OneDown or stV1TwoDown or stV1ThreeDown

// Zone V1 classification — direct port of st-zone.ts zone logic.
bool stZoneV1PlusThree = stV1Ready and ((stBarMid > stCtfFastMid and stV1IsUpCategory) or (stBarMid > stHtfFastMidStepped and stV1IsDownCategory))
bool stZoneV1MinusThree = stV1Ready and ((stBarMid < stCtfFastMid and stV1IsDownCategory) or (stBarMid < stHtfFastMidStepped and stV1IsUpCategory))
bool stZoneV1PlusTwo = stV1Ready and ((stBarMid > stCtfSlowMid and stBarMid <= stCtfFastMid) and (stV1TwoUp or stV1ThreeUp))
bool stZoneV1MinusTwo = stV1Ready and ((stBarMid < stCtfSlowMid and stBarMid >= stCtfFastMid) and (stV1TwoDown or stV1ThreeDown))
bool stZoneV1PlusOne = stV1Ready and ((stBarMid > stHtfFastMidStepped and stBarMid <= stCtfSlowMid) and stV1IsUpCategory)
bool stZoneV1MinusOne = stV1Ready and ((stBarMid < stHtfFastMidStepped and stBarMid >= stCtfSlowMid) and stV1IsDownCategory)

int stZoneV1 = stZoneV1PlusThree ? 3 : stZoneV1PlusTwo ? 2 : stZoneV1PlusOne ? 1 : stZoneV1MinusOne ? -1 : stZoneV1MinusTwo ? -2 : stZoneV1MinusThree ? -3 : 0

// --- Zone V2: -4 to +4 from all 4 bands ---
// Warm-up guard: TypeScript st-zone-v2.ts skips bars where any of the four
// band midpoints is NaN. Without this guard, Pine bool direction flags are
// all false during warm-up (na comparisons return false), making stV2BaseZone
// evaluate to -4 and plotting spurious zoneMinusFour crosses. The explicit
// guard ensures zone 0 (no plot) during warm-up, matching TypeScript.
bool stV2Ready = not na(stCtfFastMid) and not na(stCtfSlowMid) and not na(stHtfFastMidStepped) and not na(stHtfSlowMidStepped)

// baseZone = sum of (+1/-1) per band direction. The HTF bands use stepped
// direction to match the TypeScript BandResult up/dn flags.
int stV2BaseZone = (stCtfFastUp ? 1 : -1) + (stCtfSlowUp ? 1 : -1) + (stHtfFastUpStepped ? 1 : -1) + (stHtfSlowUpStepped ? 1 : -1)

// Refine base zone using bar midpoint vs the opposing band's midpoint.
// TypeScript classifyZone: base 4/-4 → 4/-4; base 2 → 3 if barMid > bearishMid;
// base -2 → -3 if barMid < bullishMid; base 0 → 1 if barMid > avgMid else -1.
int stZoneV2 = 0
if stV2Ready
    if stV2BaseZone == 4
        stZoneV2 := 4
    else if stV2BaseZone == -4
        stZoneV2 := -4
    else if stV2BaseZone == 2
        // 3 bullish, 1 bearish — use the bearish band's midpoint.
        float bearishMid = not stCtfFastUp ? stCtfFastMid : not stCtfSlowUp ? stCtfSlowMid : not stHtfFastUpStepped ? stHtfFastMidStepped : stHtfSlowMidStepped
        stZoneV2 := stBarMid > bearishMid ? 3 : 2
    else if stV2BaseZone == -2
        // 3 bearish, 1 bullish — use the bullish band's midpoint.
        float bullishMid = stCtfFastUp ? stCtfFastMid : stCtfSlowUp ? stCtfSlowMid : stHtfFastUpStepped ? stHtfFastMidStepped : stHtfSlowMidStepped
        stZoneV2 := stBarMid < bullishMid ? -3 : -2
    else if stV2BaseZone == 0
        // 2 bullish, 2 bearish — use average of all four midpoints.
        float avgMid = (stCtfFastMid + stCtfSlowMid + stHtfFastMidStepped + stHtfSlowMidStepped) / 4.0
        stZoneV2 := stBarMid > avgMid ? 1 : -1
    else
        stZoneV2 := 0

// --- Zone V1 lower-pane plots (range 0..5, matching historical Pine) ---
// Plotted as crosses at fixed y-levels so each zone value occupies its own
// row. The historical rb-smha-four-band-plot.pine used this layout.
plot(stZoneV1 == 3 ? 5 : na, "V1 zonePlusThree", style=plot.style_cross, linewidth=3, color=color.blue)
plot(stZoneV1 == 2 ? 4 : na, "V1 zonePlusTwo", style=plot.style_cross, linewidth=3, color=color.teal)
plot(stZoneV1 == 1 ? 3 : na, "V1 zonePlusOne", style=plot.style_cross, linewidth=3, color=color.silver)
plot(stZoneV1 == -1 ? 2 : na, "V1 zoneMinusOne", style=plot.style_cross, linewidth=3, color=color.white)
plot(stZoneV1 == -2 ? 1 : na, "V1 zoneMinusTwo", style=plot.style_cross, linewidth=3, color=color.fuchsia)
plot(stZoneV1 == -3 ? 0 : na, "V1 zoneMinusThree", style=plot.style_cross, linewidth=3, color=color.yellow)

// --- Zone V2 lower-pane plots (fixed rows 7..14, skipping row 6) ---
// V1 occupies rows 0..5. Row 6 is a blank separator. V2 occupies rows 7..14.
// Positive zones map to zone+10 (e.g. +4→14, +1→11). Negative zones map to
// zone+11 (e.g. -1→10, -4→7) so they stack above the V1 rows without overlap.
plot(stZoneV2 == 4 ? 14 : na, "V2 zonePlusFour", style=plot.style_cross, linewidth=3, color=color.lime)
plot(stZoneV2 == 3 ? 13 : na, "V2 zonePlusThree", style=plot.style_cross, linewidth=3, color=color.blue)
plot(stZoneV2 == 2 ? 12 : na, "V2 zonePlusTwo", style=plot.style_cross, linewidth=3, color=color.teal)
plot(stZoneV2 == 1 ? 11 : na, "V2 zonePlusOne", style=plot.style_cross, linewidth=3, color=color.silver)
plot(stZoneV2 == -1 ? 10 : na, "V2 zoneMinusOne", style=plot.style_cross, linewidth=3, color=color.white)
plot(stZoneV2 == -2 ? 9 : na, "V2 zoneMinusTwo", style=plot.style_cross, linewidth=3, color=color.fuchsia)
plot(stZoneV2 == -3 ? 8 : na, "V2 zoneMinusThree", style=plot.style_cross, linewidth=3, color=color.yellow)
plot(stZoneV2 == -4 ? 7 : na, "V2 zoneMinusFour", style=plot.style_cross, linewidth=3, color=color.red)

// =============================================================================
// TREND STRENGTH (DI+/-) — lower pane
// =============================================================================

// ST Trend Strength uses Wilder's DI+/DI- with all lookbacks using the HTF
// multiplier (3). This matches the TypeScript st-trend-strength.ts and the
// historical rb-DI-plus-minus-lib.pine. The lookback for true range, directional
// movement, and Wilder smoothing is [HTF_MULTIPLIER] (i.e. [3]), not [1].
//
// The DI histogram (diPlus - diMinus) is the primary visual. It is plotted
// with a vertical offset so it does not overlap the zone crosses at rows 0-14.
// Threshold hlines at +10 and -10 (offset) mark the DI strength boundaries.
//
// No main-pane dot overlay is produced by this task (per PRD non-goal and
// Task #232 acceptance criteria).

// DI Trend Strength engine. Returns diPlus, diMinus, diHist, dx, adx.
// All lookbacks use HTF_MULTIPLIER (3) to match the TypeScript implementation.
// TypeScript skips the first `mult` bars (if (i < mult) continue); the Pine
// guard returns na for those bars to avoid nz() coercing missing history to 0,
// which would produce diHist ≈ 100 on the first 3 bars.
f_st_trend_strength(
    series float srcHigh,
    series float srcLow,
    series float srcClose,
    simple int adxLength) =>
    // Warm-up guard: skip the first HTF_MULTIPLIER bars (matching TypeScript).
    bool stDiReady = bar_index >= HTF_MULTIPLIER

    // True Range with HTF multiplier lookback: max(H-L, |H-prevClose|, |L-prevClose|)
    float prevClose = nz(srcClose[HTF_MULTIPLIER])
    float trueRange = math.max(math.max(srcHigh - srcLow, math.abs(srcHigh - prevClose)), math.abs(srcLow - prevClose))

    // Directional Movement with HTF multiplier lookback
    float upMove = srcHigh - nz(srcHigh[HTF_MULTIPLIER])
    float downMove = nz(srcLow[HTF_MULTIPLIER]) - srcLow
    float dmPlus = (upMove > downMove and upMove > 0) ? upMove : 0.0
    float dmMinus = (downMove > upMove and downMove > 0) ? downMove : 0.0

    // Wilder smoothing: smoothed[i] = smoothed[i-mult] - (smoothed[i-mult]/period) + current
    // nz() converts na to 0, matching TypeScript's nz() for the initial bars.
    float smoothedTR = 0.0
    smoothedTR := nz(smoothedTR[HTF_MULTIPLIER]) - (nz(smoothedTR[HTF_MULTIPLIER]) / adxLength) + trueRange

    float smoothedDMPlus = 0.0
    smoothedDMPlus := nz(smoothedDMPlus[HTF_MULTIPLIER]) - (nz(smoothedDMPlus[HTF_MULTIPLIER]) / adxLength) + dmPlus

    float smoothedDMMinus = 0.0
    smoothedDMMinus := nz(smoothedDMMinus[HTF_MULTIPLIER]) - (nz(smoothedDMMinus[HTF_MULTIPLIER]) / adxLength) + dmMinus

    // DI+ and DI- (na during warm-up to match TypeScript skip behavior)
    float diPlus = stDiReady ? (smoothedTR != 0 ? (smoothedDMPlus / smoothedTR) * 100.0 : 0.0) : na
    float diMinus = stDiReady ? (smoothedTR != 0 ? (smoothedDMMinus / smoothedTR) * 100.0 : 0.0) : na

    // DX and ADX
    float diSum = diPlus + diMinus
    float dx = stDiReady ? (diSum != 0 ? (math.abs(diPlus - diMinus) / diSum) * 100.0 : 0.0) : na
    float adx = ta.sma(dx, adxLength)

    // DI histogram
    float diHist = stDiReady ? (diPlus - diMinus) : na

    [diPlus, diMinus, diHist, dx, adx]

// Instantiate Trend Strength on chart OHLC with the fixed DI length.
[stDiPlus, stDiMinus, stDiHist, stDx, stAdx] = f_st_trend_strength(high, low, close, DI_LENGTH)

// Plot the DI histogram in the lower pane, offset below the zone crosses.
// Zones occupy rows 0-14. diHist can range roughly -60 to +60 in strong trends.
// The offset of -80 places the zero line at -80, thresholds at -70 and -90,
// and a diHist of +60 at -20 — clearly below the zone area.
const float ST_DI_HIST_OFFSET = -80.0
const float DI_ZERO_OFFSET = ST_DI_HIST_OFFSET
const float DI_UPPER_OFFSET = DI_UPPER_THRESHOLD + ST_DI_HIST_OFFSET
const float DI_LOWER_OFFSET = DI_LOWER_THRESHOLD + ST_DI_HIST_OFFSET

color stDiHistColor = stDiHist > 0 ? color.new(color.blue, 0) : color.new(color.yellow, 0)
plot(stDiHist + ST_DI_HIST_OFFSET, "DI Histogram", color=stDiHistColor, style=plot.style_histogram, linewidth=3)

// Threshold and zero lines for the DI histogram (all offset).
hline(DI_ZERO_OFFSET, "DI Zero", color=color.gray, linestyle=hline.style_dotted)
hline(DI_UPPER_OFFSET, "DI Upper Threshold", color=color.gray, linestyle=hline.style_dashed)
hline(DI_LOWER_OFFSET, "DI Lower Threshold", color=color.gray, linestyle=hline.style_dashed)

// Hidden named plots for CSV export validation (diPlus, diMinus, dx, adx).
// display.data_window keeps them out of the pane but available in the Data
// Window and "Export chart data" CSV output for validation task #235.
plot(stDiPlus, "DI+", color=color.new(color.blue, 100), display=display.data_window)
plot(stDiMinus, "DI-", color=color.new(color.yellow, 100), display=display.data_window)
plot(stDx, "DX", color=color.new(color.white, 100), display=display.data_window)
plot(stAdx, "ADX", color=color.new(color.orange, 100), display=display.data_window)

// =============================================================================
// MAIN-PANE EVENT OVERLAY — Zone V1/V2 signal-event dots
// =============================================================================

// ST Trend Rider signal-event dots on the main price pane.
//
// Signal rules (ported from st-trend-rider-dots.indicator.ts):
//   Long  (window open when V2 zone > 0): V1/V2 zone was falling while
//          already >= +1, then upticks once → long dot below candle.
//          No repeat until zone falls (delta < 0), then upticks again.
//          Flat bars (delta == 0) do not change state.
//   Short (window open when V2 zone < 0): V1/V2 zone was rising while
//          already <= -1, then downticks once → short dot above candle.
//          No repeat until zone rises (delta > 0), then downticks again.
//          Flat bars (delta == 0) do not change state.
//
// Placement: long dots at bar.low - ATR*2.5, short dots at bar.high + ATR*2.5.
// V1 and V2 are visually distinguishable (different colors/shapes).
// Long and short are visually distinguishable (above vs below candle).
// No strategy side effects — this is an indicator, not a strategy.

// ATR for dot offset sizing. Pine's built-in ta.atr uses Wilder's smoothing,
// matching the TypeScript computeATR (SMA seed + EMA-style smoothing).
float stAtr = ta.atr(ATR_LENGTH)
float stDotOffset = stAtr * ZONE_DOT_ATR_MULTIPLIER

// --- V1 Trend Rider dots ---
// Uses V1 zone for transitions, V2 zone for window-open check.
// State machine: READY = waiting for uptick/downtick, FIRED = already signalled.
var int stV1LongState = 0   // 0 = READY, 1 = FIRED
var int stV1ShortState = 0  // 0 = READY, 1 = FIRED

int stV1PrevZone = nz(stZoneV1[1], 0)
int stV1Delta = stZoneV1 - stV1PrevZone

// V1 Long: window open when V2 zone > 0, prev V1 zone >= 1, V1 uptick
bool stV1LongEvent = false
if stZoneV2 > 0
    if stV1Delta > 0
        if stV1LongState == 0 and stV1PrevZone >= 1
            stV1LongEvent := true
            stV1LongState := 1
    else if stV1Delta < 0
        stV1LongState := 0
else
    stV1LongState := 0

// V1 Short: window open when V2 zone < 0, prev V1 zone <= -1, V1 downtick
bool stV1ShortEvent = false
if stZoneV2 < 0
    if stV1Delta < 0
        if stV1ShortState == 0 and stV1PrevZone <= -1
            stV1ShortEvent := true
            stV1ShortState := 1
    else if stV1Delta > 0
        stV1ShortState := 0
else
    stV1ShortState := 0

// V1 dot plots — circles below (long) / above (short) candle, force_overlay for main pane.
plot(stV1LongEvent ? low - stDotOffset : na, "V1 Long", style=plot.style_circles, linewidth=3, color=color.new(color.green, 0), force_overlay=true)
plot(stV1ShortEvent ? high + stDotOffset : na, "V1 Short", style=plot.style_circles, linewidth=3, color=color.new(color.red, 0), force_overlay=true)

// --- V2 Trend Rider dots ---
// Uses V2 zone for both transitions and window-open check.
var int stV2LongState = 0   // 0 = READY, 1 = FIRED
var int stV2ShortState = 0  // 0 = READY, 1 = FIRED

int stV2PrevZone = nz(stZoneV2[1], 0)
int stV2Delta = stZoneV2 - stV2PrevZone

// V2 Long: window open when V2 zone > 0, prev V2 zone >= 1, V2 uptick
bool stV2LongEvent = false
if stZoneV2 > 0
    if stV2Delta > 0
        if stV2LongState == 0 and stV2PrevZone >= 1
            stV2LongEvent := true
            stV2LongState := 1
    else if stV2Delta < 0
        stV2LongState := 0
else
    stV2LongState := 0

// V2 Short: window open when V2 zone < 0, prev V2 zone <= -1, V2 downtick
bool stV2ShortEvent = false
if stZoneV2 < 0
    if stV2Delta < 0
        if stV2ShortState == 0 and stV2PrevZone <= -1
            stV2ShortEvent := true
            stV2ShortState := 1
    else if stV2Delta > 0
        stV2ShortState := 0
else
    stV2ShortState := 0

// V2 dot plots — crosses below (long) / above (short) candle, force_overlay for main pane.
// V2 uses a different shape (cross) from V1 (circle) so they are visually distinguishable.
plot(stV2LongEvent ? low - stDotOffset : na, "V2 Long", style=plot.style_cross, linewidth=3, color=color.new(color.lime, 0), force_overlay=true)
plot(stV2ShortEvent ? high + stDotOffset : na, "V2 Short", style=plot.style_cross, linewidth=3, color=color.new(color.orange, 0), force_overlay=true)
